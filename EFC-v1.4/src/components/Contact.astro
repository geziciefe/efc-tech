---
import T from './T.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import PageIntro from './PageIntro.astro';
import { site } from '../data/site';
import { products } from '../data/products';
import { t } from '../data/translations';
const { lang = 'tr' } = Astro.props;
const fields = [
  { name: 'fullName', key: 'fullName', type: 'text', auto: 'name', required: true },
  {
    name: 'organization',
    key: 'organization',
    type: 'text',
    auto: 'organization',
    required: false,
  },
  { name: 'email', key: 'email', type: 'email', auto: 'email', required: true },
  { name: 'phone', key: 'phone', type: 'tel', auto: 'tel', required: false },
] as const;
---

<PageIntro label="contact" title="contactTitle" description="contactIntro" />
<section class="section">
  <div class="container contact-grid">
    <div class="form-panel">
      <h2>
        <T k="formTitle" />
      </h2>
      <p class="form-note">
        <T k="formNote" />
      </p>
      <p class="required-note">
        <T k="requiredNote" />
      </p>
      <form id="enquiry-form" method="dialog" novalidate>
        <div class="form-grid">
          {fields.map((f) => (
            <div class="field">
              <label for={f.name}>
                <T k={f.key} />{' '}
                {f.required ? (
                  '*'
                ) : (
                  <span class="optional">
                    (<T k="optional" />)
                  </span>
                )}
              </label>
              <input
                id={f.name}
                name={f.name}
                type={f.type}
                autocomplete={f.auto}
                required={f.required}
                aria-describedby={`${f.name}-error`}
                maxlength={f.name === 'phone' ? 30 : 160}
              />
              <span class="field-error" id={`${f.name}-error`} hidden></span>
            </div>
          ))}
          <div class="field full">
            <label for="interest">
              <T k="interest" />
            </label>
            <select id="interest" name="interest">
              <option value="" data-text-tr={t('general', 'tr')} data-text-en={t('general', 'en')}>
                {t('general', lang)}
              </option>
              {products.map((p) => (
                <option value={p.slug} data-text-tr={p.name.tr} data-text-en={p.name.en}>
                  {p.name[lang as 'tr' | 'en']}
                </option>
              ))}
            </select>
          </div>
          <div class="field full">
            <label for="message">
              <T k="message" /> *
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              maxlength="4000"
              aria-describedby="message-error"
            ></textarea>
            <span class="field-error" id="message-error" hidden></span>
          </div>
          <div class="field full">
            <label class="checkbox-label">
              <input
                type="checkbox"
                id="consent"
                name="consent"
                required
                aria-describedby="consent-error"
              />
              <span>
                <T k="consent" />
              </span>
            </label>
            <span class="field-error" id="consent-error" hidden></span>
          </div>
        </div>
        <button class="button" type="submit" disabled>
          <T k="submit" />
          <Icon />
        </button>
        <div class="form-result" id="form-result" role="status" tabindex="-1" hidden>
          <Icon name="check" />
          <T k="submitted" />
        </div>
      </form>
    </div>
    <aside class="contact-aside">
      <h2>
        <T k="contact" />
      </h2>
      {(
        [
          { key: 'phone', icon: 'phone' },
          { key: 'email', icon: 'mail' },
          { key: 'address', icon: 'pin' },
          { key: 'hours', icon: 'clock' },
        ] as const
      ).map((c) => (
        <div class="contact-row">
          <Icon name={c.icon} />
          <div>
            <h3>
              <T k={c.key} />
            </h3>
            {site.contact[c.key] ? (
              c.key === 'phone' ? (
                <p><a href={`tel:${site.contact.phone?.replace(/\D/g, '')}`}>{site.contact.phone}</a></p>
              ) : (
                <p>{site.contact[c.key]}</p>
              )
            ) : (
              <p class="pending">
                <T k="pending" />
              </p>
            )}
          </div>
        </div>
      ))}
      <div class="contact-map">
        {site.contact.mapUrl ? (
          <a class="text-link" href={site.contact.mapUrl} target="_blank" rel="noopener noreferrer">
            <T k="map" />
            <Icon name="diagonal" />
          </a>
        ) : (
          <Placeholder kind="map" label="mapPending" />
        )}
      </div>
    </aside>
  </div>
</section>
