---
import T from './T.astro';
import MediaCanvas from './MediaCanvas.astro';
import { productsIntroImage } from '../data/visuals';
const { lang = 'tr', page = false } = Astro.props;
const Heading = page ? 'h1' : 'h2';
---

<section
  class:list={['products-intro', { 'products-intro--page': page }]}
  aria-labelledby="products-heading"
>
  <MediaCanvas image={productsIntroImage} lang={lang} priority={page} />
  <div class="products-intro-shade" aria-hidden="true"></div>
  <div class="container products-intro-grid">
    <div class="products-intro-copy">
      <Heading id="products-heading">
        <T k="products" />
      </Heading>
      {page && (
        <p>
          <T k="productsIntro" />
        </p>
      )}
    </div>
  </div>
</section>
