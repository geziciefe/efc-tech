---
import T from './T.astro';
import Icon from './Icon.astro';
import MediaCanvas from './MediaCanvas.astro';
import { heroSlides, heroSettings } from '../data/visuals';
import { t } from '../data/translations';
import { localizedPath } from '../data/site';
const { lang = 'tr' } = Astro.props;
---

<section
  class="hero"
  data-hero
  data-autoplay={heroSettings.autoplay}
  data-interval={heroSettings.interval}
  role="region"
  aria-roledescription="carousel"
  aria-label={t('heroCarousel', lang)}
  data-aria-tr={t('heroCarousel', 'tr')}
  data-aria-en={t('heroCarousel', 'en')}
  tabindex="0"
>
  <div class="hero-slides">
    {heroSlides.map((slide, i) => (
      <div
        class:list={['hero-slide', { 'is-active': i === 0 }]}
        data-hero-slide
        aria-hidden={i !== 0}
        inert={i !== 0}
        data-category={slide.category}
      >
        <MediaCanvas image={slide.image} lang={lang} priority={i === 0} />
      </div>
    ))}
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content container">
    <h1 class="hero-primary-title">
      <a class="hero-primary-link" href={localizedPath('/products/', lang)} data-route="/products/">
        <T k="products" />
      </a>
    </h1>
    <div class="sr-only">
      {heroSlides.map((slide, i) => (
        <span
          class:list={['hero-text', { 'is-active': i === 0 }]}
          data-hero-title
          aria-hidden={i !== 0}
        >
          <T text={slide.title} />
        </span>
      ))}
    </div>
  </div>
  <div class="hero-controls">
    <button
      type="button"
      class="hero-prev icon-button"
      data-hero-prev
      aria-label={t('previous', lang)}
      data-aria-tr={t('previous', 'tr')}
      data-aria-en={t('previous', 'en')}
    >
      <Icon name="chevronLeft" size={24} />
    </button>
    <div
      class="hero-dots"
      role="group"
      aria-label={t('slide', lang)}
      data-aria-tr={t('slide', 'tr')}
      data-aria-en={t('slide', 'en')}
    >
      {heroSlides.map((slide, i) => (
        <button
          type="button"
          data-hero-dot={i}
          aria-pressed={i === 0}
          aria-label={`${t('slide', lang)} ${i + 1}: ${slide.title[lang as 'tr' | 'en']}`}
          data-aria-tr={`${t('slide', 'tr')} ${i + 1}: ${slide.title.tr}`}
          data-aria-en={`${t('slide', 'en')} ${i + 1}: ${slide.title.en}`}
        >
          <span></span>
        </button>
      ))}
    </div>
    <button
      type="button"
      class="hero-next icon-button"
      data-hero-next
      aria-label={t('next', lang)}
      data-aria-tr={t('next', 'tr')}
      data-aria-en={t('next', 'en')}
    >
      <Icon name="chevronRight" size={24} />
    </button>
  </div>
  <p class="sr-only" data-hero-status aria-live="polite" aria-atomic="true"></p>
</section>
