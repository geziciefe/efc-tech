---
import T from './T.astro';
import Icon from './Icon.astro';
import ProductsIntro from './ProductsIntro.astro';
import ProductCard from './ProductCard.astro';
import CTA from './CTA.astro';
import { products, categories } from '../data/products';
import { t } from '../data/translations';
const { lang = 'tr' } = Astro.props;
---

<ProductsIntro lang={lang} page />
<section class="section catalogue-section">
  <div class="container catalogue-layout">
    <aside class="catalogue-sidebar">
      <h2>
        <T k="categories" />
      </h2>
      <div
        class="category-filters"
        role="group"
        aria-label={t('categories', lang)}
        data-aria-tr={t('categories', 'tr')}
        data-aria-en={t('categories', 'en')}
      >
        <button type="button" data-filter="all" aria-pressed="true">
          <T k="allProducts" />
        </button>
        {categories.map((c) => (
          <button type="button" data-filter={c.id} aria-pressed="false">
            <T text={c.name} />
          </button>
        ))}
      </div>
    </aside>
    <div class="catalogue-main">
      <div class="catalogue-toolbar">
        <div class="search-field">
          <Icon name="search" />
          <label class="sr-only" for="product-search">
            <T k="search" />
          </label>
          <input
            id="product-search"
            type="search"
            placeholder={t('searchPlaceholder', lang)}
            data-placeholder-tr={t('searchPlaceholder', 'tr')}
            data-placeholder-en={t('searchPlaceholder', 'en')}
          />
        </div>
        <p class="result-count" role="status" aria-live="polite">
          <strong id="result-count">{products.length}</strong> <T k="results" />
        </p>
      </div>
      <div class="product-grid" id="catalogue-grid">
        {products.map((product) => (
          <ProductCard product={product} lang={lang} />
        ))}
      </div>
      <div id="empty-state" class="empty-state" hidden>
        <Icon name="search" size={32} />
        <h2>
          <T k="empty" />
        </h2>
        <button class="button" type="button" data-reset>
          <T k="reset" />
        </button>
      </div>
    </div>
  </div>
</section>
<CTA lang={lang} />
