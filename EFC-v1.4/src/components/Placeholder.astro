---
import AssetLabel from './AssetLabel.astro';
import { t, type CopyKey } from '../data/translations';
import { assetGuidance } from '../data/visuals';
interface Props {
  kind?: 'product' | 'hero' | 'company' | 'video' | 'map';
  label?: CopyKey;
  number?: string;
}
const { kind = 'product', label = 'productImage' } = Astro.props;
---

<div class:list={['placeholder', `placeholder-${kind}`]}>
  <AssetLabel
    subject={{ tr: t(label, 'tr'), en: t(label, 'en') }}
    guidance={assetGuidance[kind === 'hero' ? 'company' : kind]}
  />
</div>
