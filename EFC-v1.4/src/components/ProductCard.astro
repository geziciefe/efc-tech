---
import T from './T.astro';
import Placeholder from './Placeholder.astro';
import { categoryFor, type Product } from '../data/products';
import { localizedPath } from '../data/site';
const { product, lang = 'tr' } = Astro.props as { product: Product; lang: string };
const route = `/products/${product.slug}/`;
const showsSeparateModel = product.model && !product.name.tr.includes(product.model);
---

<a
  class="product-card"
  href={localizedPath(route, lang)}
  data-route={route}
  data-product-card
  data-category={product.category}
  data-search-tr={`${product.name.tr} ${categoryFor(product.category).name.tr} ${product.model ?? ''}`}
  data-search-en={`${product.name.en} ${categoryFor(product.category).name.en} ${product.model ?? ''}`}
>
  <div class="product-image">
    {product.images.length ? (
      <img
        src={product.images[0].src}
        alt={product.images[0].alt[lang as 'tr' | 'en']}
        data-alt-tr={product.images[0].alt.tr}
        data-alt-en={product.images[0].alt.en}
        width="700"
        height="525"
        loading="lazy"
      />
    ) : (
      <Placeholder />
    )}
  </div>
  <div class="product-copy">
    <span class="product-category">
      <T text={categoryFor(product.category).name} />
    </span>
    <h3>
      <T text={product.name} />
    </h3>
    {showsSeparateModel && <p class="product-model">{product.model}</p>}
    {product.images.length > 0 && (
      <p class="product-description">
        <T text={product.description} />
      </p>
    )}
    <span class="card-action">
      <T k="viewProduct" />
    </span>
  </div>
</a>
