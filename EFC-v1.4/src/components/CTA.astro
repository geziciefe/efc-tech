---
import T from './T.astro';
import { localizedPath } from '../data/site';
const { lang = 'tr' } = Astro.props;
---

<section class="contact-cta">
  <div class="container cta-inner">
    <div>
      <h2>
        <T k="ctaTitle" />
      </h2>
      <p>
        <T k="ctaDesc" />
      </p>
    </div>
    <a class="button button-white" href={localizedPath('/contact/', lang)} data-route="/contact/">
      <T k="info" />
    </a>
  </div>
</section>
