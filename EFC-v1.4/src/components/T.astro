---
import { copy, type CopyKey } from '../data/translations';
import type { Localized } from '../data/products';
interface Props {
  k?: CopyKey;
  text?: Localized;
}
const { k, text } = Astro.props;
const tr = text?.tr ?? (k ? copy[k][0] : '');
const en = text?.en ?? (k ? copy[k][1] : '');
---

<span class="i18n">
  <span class="lang-tr">{tr}</span>
  <span class="lang-en">{en}</span>
</span>
