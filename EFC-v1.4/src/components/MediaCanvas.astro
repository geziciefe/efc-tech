---
import AssetLabel from './AssetLabel.astro';
import type { EditorialImage } from '../data/visuals';
const {
  image,
  lang = 'tr',
  priority = false,
} = Astro.props as { image: EditorialImage; lang: 'tr' | 'en'; priority?: boolean };
---

<div
  class:list={['media-canvas', `tone-${image.tone}`, { 'is-placeholder': !image.src }]}
  style={`--focal:${image.focalPoint};--mobile-focal:${image.mobileFocalPoint}`}
>
  {image.src ? (
    <img
      src={image.src}
      alt={image.alt[lang]}
      data-alt-tr={image.alt.tr}
      data-alt-en={image.alt.en}
      width="1920"
      height="1080"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  ) : (
    <AssetLabel subject={image.subject} guidance={image.ratio} />
  )}
</div>
