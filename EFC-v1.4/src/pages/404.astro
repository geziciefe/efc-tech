---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import T from '../components/T.astro';
---

<Layout title="notFound" path="/404/" robots="noindex,follow">
  <PageIntro label="notFound" title="notFound" description="notFoundBody" />
  <section class="section">
    <div class="container">
      <a class="button" href="/" data-route="/">
        <T k="home" />
      </a>
    </div>
  </section>
</Layout>
