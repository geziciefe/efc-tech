---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import Catalogue from '../components/Catalogue.astro';
import ProductDetail from '../components/ProductDetail.astro';
import About from '../components/About.astro';
import ReferencesPage from '../components/ReferencesPage.astro';
import Contact from '../components/Contact.astro';
import PageIntro from '../components/PageIntro.astro';
import T from '../components/T.astro';
import { products, type Product } from '../data/products';
import { localizedPath } from '../data/site';
import type { CopyKey } from '../data/translations';
export function getStaticPaths() {
  const paths: { route: string; kind: string; title: CopyKey; product?: Product }[] = [
    { route: '', kind: 'home', title: 'heroTitle' },
    { route: 'products', kind: 'products', title: 'products' },
    { route: 'about', kind: 'about', title: 'about' },
    { route: 'references', kind: 'references', title: 'references' },
    { route: 'contact', kind: 'contact', title: 'contact' },
    ...['privacy', 'kvkk'].map((route) => ({
      route,
      kind: 'legal',
      title: 'legalTitle' as CopyKey,
    })),
    ...products.map((product) => ({
      route: `products/${product.slug}`,
      kind: 'product',
      title: 'products' as CopyKey,
      product,
    })),
  ];
  return (['tr', 'en'] as const).flatMap((lang) =>
    paths.map((p) => ({
      params: { path: (lang === 'en' ? 'en/' : '') + p.route || undefined },
      props: { ...p, lang, path: p.route ? `/${p.route}/` : '/' },
    })),
  );
}
const { lang, path, kind, title, product } = Astro.props;
---

<Layout lang={lang} path={path} title={title} product={product} robots={kind === 'legal' ? 'noindex,follow' : undefined}>
  {kind === 'home' && <Home lang={lang} />}
  {kind === 'products' && <Catalogue lang={lang} />}
  {kind === 'product' && <ProductDetail lang={lang} product={product} />}
  {kind === 'about' && <About lang={lang} />}
  {kind === 'references' && <ReferencesPage lang={lang} />}
  {kind === 'contact' && <Contact lang={lang} />}
  {kind === 'legal' && (
    <>
      <PageIntro label="draft" title="legalTitle" description="legalBody" />
      <section class="section">
        <div class="container">
          <a class="button" href={localizedPath('/', lang)} data-route="/">
            <T k="home" />
          </a>
        </div>
      </section>
    </>
  )}
</Layout>
