---
import '../styles/global.css';
import '../styles/chrome.css';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import { site, navigation, localizedPath } from '../data/site';
import { categories } from '../data/products';
import { t, type Lang, type CopyKey } from '../data/translations';
const {
  lang = 'tr',
  path = '/',
  title = 'heroTitle',
  product,
} = Astro.props as { lang: Lang; path: string; title: CopyKey; product?: any };
const pageTitles = {
  tr: `${product ? product.name.tr : t(title, 'tr')} | EFC Technology`,
  en: `${product ? product.name.en : t(title, 'en')} | EFC Technology`,
};
const overlayHeader = ['/', '/products/', '/about/'].includes(path);
const headerNavigation = navigation.filter((item) => item.key !== 'references');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#111722" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{pageTitles[lang]}</title>
    <meta name="description" content={t('footerDesc', lang)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/assets/fonts/montserrat-latin-1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/montserrat-latin-ext-0.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/assets/fonts/montserrat.css" />
    <link rel="alternate" hreflang="tr" href={path} />
    <link rel="alternate" hreflang="en" href={'/en' + path} />
    <link rel="alternate" hreflang="x-default" href={path} />
    <script is:inline>
      try {
        if (location.pathname === '/' && localStorage.getItem('efc-language') === 'en') {
          document.documentElement.lang = 'en';
          history.replaceState(null, '', '/en/' + location.search);
        }
      } catch {}
    </script>
  </head>
  <body
    class:list={{ 'has-overlay-header': overlayHeader }}
    data-page-path={path}
    data-title-tr={pageTitles.tr}
    data-title-en={pageTitles.en}
    data-product={product?.slug}
    data-version={site.version}
  >
    <a href="#main" class="skip-link">
      <T k="skip" />
    </a>
    <header class="site-header" data-overlay={overlayHeader}>
      <div class="container header-inner">
        <a class="brand" data-route="/" href={localizedPath('/', lang)} aria-label="EFC Technology">
          <Brand priority />
        </a>
        <nav
          class="desktop-nav"
          aria-label={t('menu', lang)}
          data-aria-tr={t('menu', 'tr')}
          data-aria-en={t('menu', 'en')}
        >
          {headerNavigation.map((n) => (
            <a
              data-route={n.path}
              href={localizedPath(n.path, lang)}
              aria-current={
                path === n.path || (n.path === '/products/' && path.startsWith('/products/'))
                  ? 'page'
                  : undefined
              }
            >
              <T k={n.key} />
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <div
            class="language-switch"
            role="group"
            aria-label={t('language', lang)}
            data-aria-tr={t('language', 'tr')}
            data-aria-en={t('language', 'en')}
          >
            <button type="button" data-lang="tr" aria-pressed={lang === 'tr'}>
              TR
            </button>
            <span>/</span>
            <button type="button" data-lang="en" aria-pressed={lang === 'en'}>
              EN
            </button>
          </div>
          <button
            type="button"
            class="menu-button"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label={t('menu', lang)}
            data-aria-tr={t('menu', 'tr')}
            data-aria-en={t('menu', 'en')}
          >
            <span class="menu-lines" aria-hidden="true">
              <span></span>
              <span></span>
            </span>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" hidden aria-label={t('menu', lang)}>
        {headerNavigation.map((n) => (
          <a
            data-route={n.path}
            href={localizedPath(n.path, lang)}
            aria-current={
              path === n.path || (n.path === '/products/' && path.startsWith('/products/'))
                ? 'page'
                : undefined
            }
          >
            <T k={n.key} />
          </a>
        ))}
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={localizedPath('/', lang)} data-route="/" aria-label="EFC Technology">
            <Brand variant="light" />
          </a>
          <p>
            <T k="footerDesc" />
          </p>
        </div>
        <div>
          <h3>
            <T k="quickLinks" />
          </h3>
          {navigation.map((n) => (
            <a href={localizedPath(n.path, lang)} data-route={n.path}>
              <T k={n.key} />
            </a>
          ))}
        </div>
        <div>
          <h3>
            <T k="categories" />
          </h3>
          {categories.map((c) => (
            <a data-route={c.path} href={localizedPath(c.path, lang)}>
              <T text={c.name} />
            </a>
          ))}
        </div>
        <div>
          <h3>
            <T k="contact" />
          </h3>
          {site.contact.phone && (
            <a class="footer-phone" href={`tel:${site.contact.phone.replace(/\D/g, '')}`}>
              {site.contact.phone}
            </a>
          )}
          {site.contact.email ? (
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          ) : !site.contact.phone ? (
            <p>
              <T k="contactPending" />
            </p>
          ) : null}
          <a class="footer-contact" data-route="/contact/" href={localizedPath('/contact/', lang)}>
            <T k="talk" />
            <Icon size={17} />
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} EFC Technology. <T k="rights" />
        </span>
        <div>
          <a
            href={site.legal.privacy ?? localizedPath('/privacy/', lang)}
            data-route={site.legal.privacy ? undefined : '/privacy/'}
          >
            <T k="privacy" />
          </a>
          <a
            href={site.legal.kvkk ?? localizedPath('/kvkk/', lang)}
            data-route={site.legal.kvkk ? undefined : '/kvkk/'}
          >
            <T k="kvkk" />
          </a>
          <span class="draft-label">
            <T k="draftVersion" /> · {site.version}
          </span>
        </div>
      </div>
    </footer>
    <button
      class="floating-wa"
      type="button"
      data-whatsapp
      aria-label={t('whatsappLabel', lang)}
      data-aria-tr={t('whatsappLabel', 'tr')}
      data-aria-en={t('whatsappLabel', 'en')}
    >
      <span class="wa-icon" aria-hidden="true">
        <Icon name="whatsapp" size={24} />
      </span>
      <span class="wa-wordmark" aria-hidden="true">
        WhatsApp
      </span>
      <span class="wa-hint" aria-hidden="true">
        <T k="waHint" />
      </span>
    </button>
    <dialog class="notice-dialog" id="whatsapp-notice" aria-labelledby="whatsapp-heading">
      <div>
        <button
          type="button"
          class="dialog-close"
          data-close
          aria-label={t('close', lang)}
          data-aria-tr={t('close', 'tr')}
          data-aria-en={t('close', 'en')}
        >
          <Icon name="close" />
        </button>
        <Icon name="whatsapp" size={35} />
        <h2 id="whatsapp-heading">WhatsApp</h2>
        <p>
          <T k="whatsappMissing" />
        </p>
        <a class="button" href={localizedPath('/contact/', lang)} data-route="/contact/">
          <T k="contact" />
          <Icon />
        </a>
      </div>
    </dialog>
    <aside class="cookie-notice" data-cookie-notice hidden aria-label={t('cookieNotice', lang)}>
      <p>
        <T k="cookieMessage" />
      </p>
      <div class="cookie-actions">
        <button type="button" class="cookie-button cookie-accept" data-cookie-choice="accepted">
          <T k="cookieAccept" />
        </button>
        <button type="button" class="cookie-button" data-cookie-choice="rejected">
          <T k="cookieReject" />
        </button>
      </div>
    </aside>
    <script>
      import '../scripts/client';
    </script>
  </body>
</html>
