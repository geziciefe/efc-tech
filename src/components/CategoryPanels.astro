---
import T from './T.astro';
import AssetLabel from './AssetLabel.astro';
import { categories } from '../data/products';
import { localizedPath } from '../data/site';
import { t } from '../data/translations';
const { lang = 'tr' } = Astro.props;
---

<section
  class="category-section"
  aria-label={t('categories', lang)}
  data-aria-tr={t('categories', 'tr')}
  data-aria-en={t('categories', 'en')}
>
  <div class="category-grid">
    {categories.map((c) => {
      const [path, query] = c.path.split('?');
      return (
        <a
          class="category-panel"
          href={localizedPath(path, lang) + (query ? '?' + query : '')}
          data-route={path}
          data-query={query ? '?' + query : undefined}
          style={`--focal:${c.focalPoint};--mobile-focal:${c.mobileFocalPoint}`}
        >
          <div class:list={['category-visual', `tone-${c.tone}`, { 'is-placeholder': !c.image }]}>
            {c.image ? (
              <img src={c.image} alt="" width="900" height="800" loading="lazy" />
            ) : (
              <AssetLabel subject={c.assetSubject} guidance="4:3 / 4:3" />
            )}
          </div>
          <div class="category-overlay" aria-hidden="true"></div>
          <div class="category-name">
            <h2>
              <T text={c.name} />
            </h2>
            <p>
              <T text={c.description} />
            </p>
            <span>
              <T k="categoryAction" />
            </span>
          </div>
        </a>
      );
    })}
  </div>
</section>
