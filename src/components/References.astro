---
import { references } from '../data/references';
import T from './T.astro';
import { localizedPath } from '../data/site';
const { lang = 'tr' } = Astro.props;
---

<section class="refs-section">
  <div class="container refs-heading">
    <h2>
      <T k="ourReferences" />
    </h2>
    <a class="text-link" data-route="/references/" href={localizedPath('/references/', lang)}>
      <T k="allReferences" />
    </a>
  </div>
  <div
    class="marquee"
    tabindex="0"
    role="region"
    aria-label={lang === 'tr' ? 'Referanslarımız' : 'Our References'}
    data-aria-tr="Referanslarımız"
    data-aria-en="Our References"
  >
    <div class="marquee-track">
      {[0, 1, 2, 3].map((group) => (
        <div class="marquee-group" aria-hidden={group > 0 ? 'true' : undefined}>
          {references.map((ref) => (
            <div class="reference-mark">
              {ref.logo && <img src={ref.logo} alt="" width="112" height="112" loading="lazy" />}
              <strong>
                <T text={ref.name} />
              </strong>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
