---
import T from './T.astro';
const { label, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="page-intro-surface" aria-hidden="true"></div>
  <div class="container">
    <p class="page-kicker">
      <T k={label} />
    </p>
    <h1>
      <T k={title} />
    </h1>
    {description && (
      <p class="page-lead">
        <T k={description} />
      </p>
    )}
  </div>
</section>
