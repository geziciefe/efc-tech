---
import T from './T.astro';
import ProductCard from './ProductCard.astro';
import { products } from '../data/products';
import { t } from '../data/translations';
import { localizedPath } from '../data/site';
const { lang = 'tr' } = Astro.props;
---

<section
  class="featured-section section"
  aria-label={t('productCarousel', lang)}
  data-aria-tr={t('productCarousel', 'tr')}
  data-aria-en={t('productCarousel', 'en')}
>
  <div class="container">
    <div class="featured-heading">
      <div>
        <h2>
          <T k="featured" />
        </h2>
      </div>
      <a class="text-link" data-route="/products/" href={localizedPath('/products/', lang)}>
        <T k="allProducts" />
      </a>
    </div>
    <div class="featured-grid">
      {products
        .filter((p) => p.featured)
        .map((product) => (
          <div class="featured-item">
            <ProductCard product={product} lang={lang} />
          </div>
        ))}
    </div>
  </div>
</section>
