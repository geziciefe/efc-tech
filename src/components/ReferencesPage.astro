---
import T from './T.astro';
import PageIntro from './PageIntro.astro';
import CTA from './CTA.astro';
import { references } from '../data/references';
const { lang = 'tr' } = Astro.props;
---

<PageIntro label="references" title="ourReferences" />
<section class="section">
  <div class="container reference-grid">
    {references.map((ref) => (
      <article class="reference-card">
        <div class="reference-logo-area">
          {ref.logo ? (
            <img
              src={ref.logo}
              alt={ref.name[lang as 'tr' | 'en']}
              data-alt-tr={ref.name.tr}
              data-alt-en={ref.name.en}
              width="130"
              height="130"
              loading="lazy"
            />
          ) : (
            <div class="institution-placeholder">
              <strong>
                <T text={ref.name} />
              </strong>
            </div>
          )}
        </div>
        <div class="reference-copy">
          <h2>
            <T text={ref.name} />
          </h2>
          {ref.projectDescription && (
            <p>
              <T text={ref.projectDescription} />
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
<CTA lang={lang} />
